# Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Machine Learning Model Assets
MODEL_PATH=model/best_model.h5
SCALER_PATH=model/saved_scaler.pkl
MAX_UPLOAD_SIZE=5242880

# Database Settings (Supports SQLite fallback or MySQL)
DATABASE_URL=sqlite:///./optilight_db.db
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@localhost:3306/optilight_db

# Security & Authentication
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
